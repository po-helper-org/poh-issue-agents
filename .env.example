# --- Temporal ---
# Нужен только для конфигурации main (docker-compose.yml) — приложение против
# ВНЕШНЕГО Temporal. Формат host:port.
# В конфигурациях local/full Temporal встроенный, адрес задан в compose-файле —
# эти переменные там не используются.
TEMPORAL_ADDRESS=
# Выделенный namespace под issue-agents. Должен уже существовать на кластере:
#   temporal operator namespace create <namespace> --address <host>:7233
# Локальный стек: default.
TEMPORAL_NAMESPACE=
# TLS к Temporal: 1/true — включить (когда кластер поддерживает TLS).
# Пусто = plain gRPC (кластер в доверенной/allowlist-сети).
TEMPORAL_TLS=

# --- Режим безопасности ---
# DRY_RUN=1 — ни одной мутации в GitHub: комментарии, лейблы и реакции только
# пишутся в лог. Пустое значение = боевой режим. Держи 1 до первого удачного
# прогона.
DRY_RUN=1

# --- Живая проверка контура (scripts/e2e_live.py) ---
# Репозиторий, на котором гоняется живой E2E. Пусто — берётся GITHUB_REPOSITORY.
# Скрипт заводит там служебный Issue и закрывает его по завершении.
E2E_REPO=

# --- Сроки ожиданий (правило R3: каждая парковка имеет дедлайн) ---
# Часы. Пусто/мусор/0 — берётся значение по умолчанию. По истечении срока Issue
# получает `needs-human:triage` с объяснением, а сессия завершается: иначе
# забытый Issue держал бы воркфлоу вечно и попадал в список зависших.
PARK_DECISION_HOURS=72        # ожидание research-me / bug-me после триажа
PARK_CLARIFICATION_HOURS=48   # ответ на уточняющий вопрос intake gate
PARK_BUILD_HOURS=72           # ожидание build-me после аналитики
PARK_SIDE_STATE_HOURS=168     # боковая фаза (spam/duplicate/answered/failed/…):
                              # сколько цикл ждёт сигнал `reopen`, прежде чем
                              # отпустить Issue

# --- Приём событий внешних агентов (#38) ---
# Секрет подписи для POST /agent-event: им подписывают доставку PR-Agent,
# PR-Closer и CI. Отдельный от GITHUB_WEBHOOK_SECRET намеренно — у соседних
# сервисов свои права, и утечка одного не должна открывать второй канал.
# ПУСТО = эндпоинт закрыт (503). Молчаливо открытый приём событий, двигающих
# фазу Issue, хуже выключенного.
AGENT_EVENT_SECRET=

# --- Активность Develop: передача задачи агенту разработки ---
# По сигналу `build-me` цикл диспатчит workflow в репозитории-цели (OpenHands
# Resolver), после чего паркуется в фазе `in-development` и ждёт события
# `pr-open` через /agent-event выше. Ждать результат активностью смысла нет:
# прогон идёт десятки минут, а исход всё равно приходит событием.
#
# ПУСТО = включено. Забытая переменная не должна тихо обрывать контур на самом
# дорогом шаге; явное `0` оставляет Issue в `ready-for-dev`, то есть в очереди к
# живому разработчику — это поведение до появления Develop и процедура отката.
DEVELOP_ENABLED=
DEVELOP_WORKFLOW_FILE=openhands-resolver.yml   # имя файла, а не имя workflow:
                                               # имя внутри файла правят свободно,
                                               # путь — контракт
DEVELOP_REF=main                               # ветка, из которой берётся workflow

# --- Search attributes Temporal (протокол агентов) ---
# 1 — проставлять RootIssue и Repo на воркфлоу: одна лента на всю цепочку от
# триажа Issue до стоп-слова на PR. ВКЛЮЧАТЬ ТОЛЬКО ПОСЛЕ регистрации атрибутов
# на кластере, иначе старт воркфлоу падает:
#   temporal operator search-attribute create --name RootIssue --type Int
#   temporal operator search-attribute create --name Repo --type Keyword
TEMPORAL_SEARCH_ATTRIBUTES=

# --- Кто вправе запускать дорогие стадии ---
# Comma-separated GitHub-логины. Пусто/не задано = разрешено всем (поведение до
# появления проверки). Проверяется автор события (sender.login), а не факт
# наличия метки: метку `run:analyze` может поставить любой с правами на
# репозиторий, а прогон стоит токенов. Триаж новых Issue гейтом НЕ закрыт.
AGENT_TRIGGER_ALLOWLIST=

# --- Аутентификация в GitHub: PAT или App ---
# Достаточно одного из двух путей. PAT проще: github_client предпочитает его,
# если он задан, и тогда блок GitHub App ниже можно оставить пустым.
# Права токена: repo (плюс admin:repo_hook, если заводишь вебхук через gh api).
GH_TOKEN=

# --- GitHub App (мультирепо) ---
# Регистрируется на github.com/settings/apps (или org-level apps для MTS).
# Permissions: Issues (read/write), Pull requests (read/write), Contents (read/write).
# Webhook events: Issues, Issue comments. Вебхук указывается в самом App.
# Установи App на нужные репозитории — их и будет отслеживать сервис.
#
# Модель как в poh-pr-agents: 4 переменные, задаются единожды.
# Installation определяется по репозиторию автоматически (GITHUB_INSTALLATION_ID не нужен).
GITHUB_APP_ID=
# Приватный ключ App в base64 (base64 -w0 github-app-private-key.pem).
GITHUB_PRIVATE_KEY_B64=
# Секрет вебхука App (тот же, что в настройках App).
GITHUB_WEBHOOK_SECRET=change-me
# Список отслеживаемых репозиториев: owner/repo,owner2/* и т.п.
#   owner/repo — конкретный; owner/* или owner — все репо owner; * или пусто — любой установленный.
ISSUE_AGENT_REPOS=your-org/your-repo
# Запасной путь к ключу-файлу (если не задан GITHUB_PRIVATE_KEY_B64).
GITHUB_PRIVATE_KEY_PATH=/app/secrets/github-app-private-key.pem

# Дефолтный репозиторий для batch-скриптов (backfill/consolidate/estimate, флаг --repo).
GITHUB_REPOSITORY=your-org/your-repo

# --- GLM через z.ai ---
# Один провайдер (z.ai), одна модель (GLM). Две пары переменных ниже — не два
# провайдера, а два формата API одного и того же z.ai.

# OpenAI-совместимый эндпоинт — используется всеми Python-стадиями
# (gate/classify/duplicate/priority/estimate) через Instructor. Обязателен.
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_API_KEY=

# Anthropic-совместимый эндпоинт того же z.ai — по нему говорит `claude -p`
# (пайплайн /analyze). Отдельно задавать НЕ нужно: креды выводятся из ZAI_*
# выше (тот же ключ, хост из ZAI_BASE_URL + путь /api/anthropic). Раскомментируй
# эти две, только если нужен явный override (другой хост/ключ для claude-пути).
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_AUTH_TOKEN=

# --- Модели ---
MODEL_GATE=glm-4.5-air
MODEL_CLASSIFY=glm-4.6

# --- Внешние инструменты ---
# TODO: способ установки/аутентификации deb8flow — подставь свой.
DEB8FLOW_BIN=deb8flow

# --- Sentry (наблюдаемость) ---
# Пусто/не задан SENTRY_DSN → Sentry выключен, стек ведёт себя как раньше (это
# же и процедура отката: убрать переменную + рестарт). Задан → пойманные сбои
# триажа (лейбл advisor:error) и /estimate становятся адресуемым событием с
# тегами service/repo/issue/stage, а не только строкой в логах контейнера. DSN
# берётся из проекта sentry.io (платформа Python). Через env_file: .env
# переменные видят оба сервиса (webhook и worker).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Опционально: версия релиза для группировки и SENTRY_TRACES_SAMPLE_RATE (0 =
# трассировка выключена, длительности стадий и так видны в Temporal UI).
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Только для конфигурации full (docker-compose.full.yml) ---
# Пароль к встроенному Postgres (хранилище Temporal). В full деплой падает,
# если переменная пуста. Сгенерируй: openssl rand -hex 24
# В main (внешний Temporal) и local Postgres свой/захардкожен — здесь не нужен.
POSTGRES_PASSWORD=

# --- Хост-порты (публикация наружу) ---
# Внутри контейнеров порты стандартные; наружу публикуются эти. Меняй, если порт
# на хосте занят (Dokploy/локально: "port is already allocated"). Пусто → дефолт.
# WEBHOOK_PORT работает во всех конфигурациях (main/local); Temporal/UI-порты —
# только в local (в main Temporal внешний, в full порты не публикуются).
WEBHOOK_PORT=3000
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_PORT=8080
