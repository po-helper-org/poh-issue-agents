{
  "mcpServers": {
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    },
    "temporal": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "temporal-mcp"
      ],
      "env": {
        "TEMPORAL_MCP_CONFIG": "/path/to/po-helper-issues/temporal-mcp.config.json"
      }
    }
  }
}